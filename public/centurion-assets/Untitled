                <div className="mt-6 flex items-center justify-between">
                  <span className="text-sm text-yellow-500/70 group-hover:text-yellow-500 transition">
                    View recognition →
                  </span>

                  <span className="text-xs text-white/30">
                    #{String(index + 1).padStart(2, "0")}
